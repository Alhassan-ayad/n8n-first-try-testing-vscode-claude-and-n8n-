{
  "name": "mngm-cep",
  "version": "1.0.0",
  "private": true,
  "description": "mngm Client Engagement Platform: journeys, campaigns, consent, caps and multi-channel delivery (eZagel SMS, SendGrid email, Firebase push).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:worker": "tsx watch --env-file=.env apps/worker/src/main.ts",
    "dev:console": "npm run dev -w @cep/console",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed/index.ts",
    "sim": "tsx --env-file=.env scripts/sim/sim.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
