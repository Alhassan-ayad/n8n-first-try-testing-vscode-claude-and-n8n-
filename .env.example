# ─────────────────────────────────────────────────────────────────────────────
# mngm Client Engagement Platform — configuration
# Copy to .env and fill in. With PROVIDER_MODE=mock nothing leaves the system;
# set PROVIDER_MODE=live once the eZagel / SendGrid / Firebase credentials below
# are filled in. No code change is needed to go live.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=Africa/Cairo
LOG_LEVEL=info

# mock | live   (per-channel override: SMS_MODE / EMAIL_MODE / PUSH_MODE)
PROVIDER_MODE=mock
SMS_MODE=
EMAIL_MODE=
PUSH_MODE=

# ── Databases ────────────────────────────────────────────────────────────────
# Engagement platform's own database (SQL Server). Prisma connection string.
DATABASE_URL="sqlserver://localhost:1433;database=mngm_cep;user=sa;password=Cep_Local_Passw0rd!;trustServerCertificate=true"
# mngm core platform database — read-only CDC user. mssql (tedious) connection string.
SOURCE_MSSQL_URL="Server=localhost,1433;Database=mngm_core;User Id=sa;Password=Cep_Local_Passw0rd!;Encrypt=true;TrustServerCertificate=true"
# Where CDC starts on first run: latest (skip history) | earliest
CDC_START=latest
CDC_POLL_MS=2000
# Comma-separated list of capture instances to skip (empty = all configured)
CDC_DISABLED_INSTANCES=

REDIS_URL=redis://localhost:6379

# ── Public URLs ──────────────────────────────────────────────────────────────
# Public base URL of this API (used in unsubscribe links and provider webhooks)
PUBLIC_BASE_URL=http://localhost:3000
# App deep link base. Every push carries a deep link built from this.
APP_DEEPLINK_BASE=mngm://app
# Web fallback for links in email/SMS
APP_WEB_BASE=https://mngm.com/app

# ── Security ─────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=change-me-long-random-string
# Shared secret the mngm backend uses to sign client-API calls (HMAC-SHA256)
CLIENT_API_HMAC_SECRET=change-me-client-hmac
# Secret used to sign unsubscribe tokens
UNSUBSCRIBE_SECRET=change-me-unsub
# First admin account (created by the seed if missing)
ADMIN_EMAIL=admin@mngm.local
ADMIN_PASSWORD=ChangeMe!2026

# ── SMS: eZagel ──────────────────────────────────────────────────────────────
EZAGEL_BASE_URL=
EZAGEL_USERNAME=
EZAGEL_PASSWORD=
# Registered sender ID (e.g. mngm)
EZAGEL_SENDER_ID=mngm
# Optional account/service code if your eZagel account uses one
EZAGEL_SERVICE=
# Token eZagel must append to DLR/inbound callback URLs (?token=...)
EZAGEL_WEBHOOK_TOKEN=change-me-ezagel-callback
# Request mapping — confirm against the eZagel API document that comes with the account:
# form | json | query
EZAGEL_REQUEST_FORMAT=form
# Rename our logical fields to eZagel's parameter names, e.g.
# {"username":"User","password":"Password","sender":"Sender","mobile":"Mobile_NO","message":"Msg","msgId":"Msg_ID"}
EZAGEL_PARAM_MAP=
# intl (201xxxxxxxxx) | local (01xxxxxxxxx)
EZAGEL_PHONE_FORMAT=intl
# Optional regex the response body must match to count as accepted
EZAGEL_SUCCESS_PATTERN=
# Opt-out keywords for marketing SMS (Arabic and English)
SMS_OPTOUT_KEYWORDS=STOP,UNSUBSCRIBE,إلغاء,الغاء,توقف
SMS_OPTOUT_FOOTER_EN=Reply STOP to opt out
SMS_OPTOUT_FOOTER_AR=للإلغاء أرسل إلغاء

# ── Email: SendGrid ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=
# Separate subdomains for transactional and marketing mail
SENDGRID_FROM_TRANSACTIONAL=mngm <no-reply@tx.mngm.com>
SENDGRID_FROM_MARKETING=mngm <news@mail.mngm.com>
SENDGRID_REPLY_TO=support@mngm.com
# Unsubscribe group (Advanced Suppression Manager) for marketing mail
SENDGRID_UNSUB_GROUP_ID=
# Optional IP pools
SENDGRID_IP_POOL_TRANSACTIONAL=
SENDGRID_IP_POOL_MARKETING=
# Signed Event Webhook verification key (Settings → Mail Settings → Event Webhook)
SENDGRID_WEBHOOK_PUBLIC_KEY=

# ── Push: Firebase Cloud Messaging ───────────────────────────────────────────
# Either a path to the service-account JSON file or the JSON inline
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── WhatsApp Business (Phase 2 — mock until a BSP is chosen) ─────────────────
WHATSAPP_MODE=mock

# ── Price engine ─────────────────────────────────────────────────────────────
VOLATILITY_THRESHOLD_PCT=2
VOLATILITY_MAX_PER_DAY=2
DIP_THRESHOLD_PCT=3
PRICE_ALERT_WINDOW_START=08:00
PRICE_ALERT_WINDOW_END=23:00

# ── Calendar ─────────────────────────────────────────────────────────────────
# Annual zakat summary send date (MM-DD, Cairo)
ZAKAT_SUMMARY_DATE=03-01
# Egyptian public holidays to skip for "business day" logic (YYYY-MM-DD, comma-separated)
PUBLIC_HOLIDAYS=

# ── Content governance ───────────────────────────────────────────────────────
# true = only Compliance-approved templates are sent (production). false = drafts
# and in-review templates are usable (local development only).
TEMPLATE_REQUIRE_APPROVAL=true
# Seed: approve seeded templates immediately (demo/staging only — never production)
SEED_APPROVE=false
# Recurring plan bonus: uninterrupted months required
RECURRING_BONUS_MONTHS=6

# ── Ports ────────────────────────────────────────────────────────────────────
API_PORT=3000
